# DB provider: local | supabase
DB_PROVIDER=local

# Local Postgres (Docker / local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=postgres

# External APIs
PLANTNET_API_KEY=
GEMINI_API_KEY=

# Supabase (only if DB_PROVIDER=supabase)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# service_role JWT from Dashboard → Settings → API (must start with eyJ... — NOT S3 access keys)
PRIVATE_SUPABASE_BUCKET_API_KEY=

# Auth — used to sign/verify login Bearer tokens (jsonwebtoken). Unrelated to Supabase keys.
# If empty, middleware falls back to a dev default; set a real secret before any shared deploy.
JWT_SECRET=
