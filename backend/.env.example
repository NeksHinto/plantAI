# DB provider: local | supabase
DB_PROVIDER=local

# Local Postgres (Docker / local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=postgres

# External APIs
PLANTNET_API_KEY=
GEMINI_API_KEY=

# Supabase (only if DB_PROVIDER=supabase)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
PRIVATE_SUPABASE_BUCKET_API_KEY=
