# Provider de Base de Datos: local | supabase
DB_PROVIDER=local

# Configuración de PostgreSQL (para entorno local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=plantAI

# APIs Externas
PLANTNET_API_KEY=
GEMINI_API_KEY=

# Supabase (Solo si DB_PROVIDER=supabase)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
PRIVATE_SUPABASE_BUCKET_API_KEY=
